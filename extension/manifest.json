{
  "manifest_version": 3,
  "name": "求职助手 - 牛客岗位采集",
  "version": "1.0.0",
  "description": "在牛客网校招页面一键采集岗位，发送到本地求职助手进行 AI 匹配分析。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.nowcoder.com/*",
    "http://127.0.0.1:8001/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "求职助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.nowcoder.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
